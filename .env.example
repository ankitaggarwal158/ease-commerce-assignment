# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Internal unified API auth (sent by consumers as: X-API-Key: <value>)
INTERNAL_API_KEY=changeme-local-dev-key

# MongoDB
MONGODB_URI=mongodb://localhost:27017/courier_platform

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Bulk processing
BULK_MAX_ORDERS=100
BULK_WORKER_CONCURRENCY=10

# --- Courier: UrbaneBolt ---
COURIER_URBANEBOLT_BASE_URL=https://uat.urbanebolt.in
COURIER_URBANEBOLT_USERNAME=info@urbanebolt.com
COURIER_URBANEBOLT_PASSWORD=changeme
COURIER_URBANEBOLT_TIMEOUT_MS=10000
COURIER_URBANEBOLT_RETRY_MAX_ATTEMPTS=3
COURIER_URBANEBOLT_RETRY_BASE_DELAY_MS=500

# --- Courier: MockCourier (bonus) --- no config needed, purely in-memory simulation, no real network calls
